{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wts-services",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  // Two dev modes (no effect on deploys):
  //   npm run dev        -> "remote": true below: binds to the *deployed*
  //                         D1/R2, so dev reads/writes PRODUCTION data.
  //                         Used on a fresh clone (e.g. the laptop), since
  //                         .wrangler/state is gitignored and starts empty.
  //                         Requires `wrangler login`.
  //   npm run dev:local  -> CLOUDFLARE_VITE_FORCE_LOCAL=true overrides
  //                         "remote" and uses the local Miniflare copy in
  //                         .wrangler/state. Safe for experiments.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wts-services-db",
      "database_id": "bb16a600-ea15-4532-8a51-e84a1d78ede9",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "wts-services-media",
      "remote": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
}
