{
  "name": "wts-services-blog",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:clean": "rm -rf .astro node_modules/.vite dist && npm run dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint .",
    "format": "prettier --write \"src/**/*.astro\" && oxfmt --ignore-path .gitignore --write .",
    "format:check": "prettier --check \"src/**/*.astro\" && oxfmt --ignore-path .gitignore --check ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.2.5",
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/react": "^6.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@emdash-cms/cloudflare": "^0.35.0",
    "astro": "^7.2.8",
    "emdash": "^0.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-external-links": "^3.0.0",
    "typescript": "^5.9.3",
    "varlock": "^0.9.1"
  },
  "devDependencies": {
    "@astrojs/mdx": "^7.0.8",
    "astro-compress": "^2.4.1",
    "browserslist": "^4.28.2",
    "lightningcss": "^1.32.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1"
  },
  "browserslist": [
    "defaults"
  ]
}
