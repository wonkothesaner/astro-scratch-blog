---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/contentComponents/BlogCard.astro";
import { getSiteSetting } from "emdash";
import { getAllPostCards } from "../../utils/blog";

const posts = await getAllPostCards();
const siteTitle = await getSiteSetting("title");
const description =
  "Home page for all Sane Musing blog posts as written by Martin Driscoll";
const title = "Blog";
---

<BaseLayout title={`${title} - ${siteTitle}`} description={description}>
  <aside>
    <h2 class="aside">
      Sane Musings - a collection of writing on a number of different subjects
    </h2>
    <ol>
      <li>
        <strong>SAP</strong> - three small letters but a very large piece of software
        that everyone uses whether they realise it or not.
      </li>
      <li>
        <strong>50+ Development</strong> - I believe we are entering a world in which
        anyone can write their own code, development their own applications, bring
        to life whatever they want. I am not being ageist but if you learn a certain
        way, have certain lived experiences from the last two or three decades of
        last year then I hope to curate a set of articles on how you can learn to
        code.
      </li>
      <li>
        <strong>Life in general</strong> - Sane Musings on living today.
      </li>
      <li>
        <strong>Miscellany</strong> - stuff that I found interesting that I have picked
        up along the way and want to share.
      </li>
    </ol>
  </aside>
  <main>
    <section class="blog-list wide">
      {posts.map((post) => <BlogCard post={post} />)}
    </section>
  </main>
</BaseLayout>

<style>
  .blog-list {
    display: grid;
    gap: var(--space-4);
  }

  .aside {
    text-wrap: balannce;
    text-align: center;
  }
</style>
