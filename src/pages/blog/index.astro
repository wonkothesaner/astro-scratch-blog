---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/contentComponents/BlogCard.astro";
import { getCollection } from "astro:content";
import { SITE_TITLE } from "../../consts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const description =
  "Home page for all Sane Musing blog posts as written by Martin Driscoll";
const title = "Blog";
---

<BaseLayout title={`${title} - ${SITE_TITLE}`} description={description}>
  <aside>
    <h2>Writings on a number of subjects...</h2>
  </aside>
  <main>
    <section class="blog-list wide">
      {posts.map((post) => <BlogCard post={post} />)}
    </section>
  </main>
</BaseLayout>

<style>
  .blog-list {
    display: grid;
    gap: var(--space-4);
  }
</style>
