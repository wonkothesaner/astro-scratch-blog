---
export const prerender = false;

import { getEmDashEntry, getEntryTerms } from "emdash";
import { PortableText } from "emdash/ui";
import BlogPost from "../../../layouts/BlogPost.astro";
import { getAllPostCards, getAdjacentPosts } from "../../../utils/blog";

const { category, slug } = Astro.params;

if (!slug || !category) {
  return Astro.redirect("/404");
}

const { entry: post, isPreview } = await getEmDashEntry("posts", slug);
if (!post) {
  return Astro.redirect("/404");
}

// Draft previews arrive at /blog/preview/<id> (forwarded from
// /preview/posts/<id>, see src/pages/preview/). `isPreview` is true only
// with a valid signed ?_preview= token, so without one this path 404s like
// any other wrong category.
const isDraftPreview = category === "preview" && isPreview;

// Otherwise the URL's category must be the post's own. post.id is the slug
// (getEmDashEntry's live-collection shape); the ULID content_taxonomies
// keys on is at .data.id.
if (!isDraftPreview) {
  const categoryTerms = await getEntryTerms("posts", post.data.id, "category");
  if (!categoryTerms.some((term) => term.slug === category)) {
    return Astro.redirect("/404");
  }
}

// getEmDashEntry also resolves a post by its database id; once the category
// is known to be right, send id addresses to the canonical slug address so
// a published post has exactly one URL.
if (!isDraftPreview && slug !== post.data.slug) {
  return Astro.redirect(`/blog/${category}/${post.data.slug}`, 301);
}

const allPosts = await getAllPostCards();
const { prev, next } = getAdjacentPosts(allPosts, Astro.url.pathname);
---

<BlogPost
  title={post.data.title}
  description={post.data.excerpt}
  pubDate={new Date(post.data.pub_date)}
  updatedDate={post.data.updated_date ? new Date(post.data.updated_date) : undefined}
  heroImage={post.data.featured_image ?? undefined}
  heroImageAlt={post.data.hero_image_alt}
  prev={prev}
  next={next}
>
  <PortableText value={post.data.content} />
</BlogPost>
