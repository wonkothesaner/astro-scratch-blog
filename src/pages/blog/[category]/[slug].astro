---
export const prerender = false;

import { getImage } from "astro:assets";
import { getEmDashEntry, getEntryTerms } from "emdash";
import { PortableText } from "emdash/ui";
import BlogPost from "../../../layouts/BlogPost.astro";
import { getAllPostCards, getAdjacentPosts } from "../../../utils/blog";
import { getMediaItem } from "../../../utils/media";

const { category, slug } = Astro.params;

if (!slug || !category) {
  return Astro.redirect("/404");
}

const { entry: post, isPreview } = await getEmDashEntry("posts", slug);
if (!post) {
  return Astro.redirect("/404");
}

// /blog/preview/… is the one address EmDash can build for a post (its URL
// patterns can't fill in a category), so it serves two admin buttons:
// - Preview: /blog/preview/<id>?_preview=<signed token> (forwarded from
//   /preview/posts/<id>, see src/pages/preview/) — show the draft;
// - Live View: /blog/preview/<slug>, no token (the posts URL pattern) —
//   301 to the post's real address below.
// `isPreview` is true only with a valid token.
const isDraftPreview = category === "preview" && isPreview;

// post.id is the slug (getEmDashEntry's live-collection shape); the ULID
// content_taxonomies keys on is at .data.id.
if (!isDraftPreview) {
  const categoryTerms = await getEntryTerms("posts", post.data.id, "category");
  const realCategory = categoryTerms[0]?.slug;
  if (category === "preview" && realCategory) {
    return Astro.redirect(`/blog/${realCategory}/${post.data.slug}`, 301);
  }
  // Otherwise the URL's category must be the post's own.
  if (!categoryTerms.some((term) => term.slug === category)) {
    return Astro.redirect("/404");
  }
}

// getEmDashEntry also resolves a post by its database id; once the category
// is known to be right, send id addresses to the canonical slug address so
// a published post has exactly one URL.
if (!isDraftPreview && slug !== post.data.slug) {
  return Astro.redirect(`/blog/${category}/${post.data.slug}`, 301);
}

// Hero image: its media-library caption is the credit, and a 1200×630 crop
// (through the Cloudflare Images binding) is the post's share image.
const hero = post.data.featured_image ?? undefined;
const heroMedia = await getMediaItem(hero?.id);
let ogImage: string | undefined;
if (heroMedia?.storageKey) {
  const src = new URL(`/_emdash/api/media/file/${heroMedia.storageKey}`, Astro.url).href;
  const shareImage = await getImage({ src, width: 1200, height: 630, fit: "cover", format: "jpg" });
  ogImage = new URL(shareImage.src, Astro.site).href;
}

const allPosts = await getAllPostCards();
const { prev, next } = getAdjacentPosts(allPosts, Astro.url.pathname);
---

<BlogPost
  title={post.data.title}
  description={post.data.excerpt}
  pubDate={new Date(post.data.pub_date)}
  updatedDate={post.data.updated_date ? new Date(post.data.updated_date) : undefined}
  heroImage={hero}
  heroImageAlt={post.data.hero_image_alt}
  heroCredit={heroMedia?.caption}
  ogImage={ogImage}
  prev={prev}
  next={next}
>
  <PortableText value={post.data.content} />
</BlogPost>
