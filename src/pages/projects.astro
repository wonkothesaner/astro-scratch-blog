---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/contentComponents/ProjectCard.astro";
import PageAside from "../components/pageComponents/PageAside.astro";
import { getEmDashEntry, getSiteSetting } from "emdash";
import { PortableText } from "emdash/ui";
import { getEntriesWithPreview } from "../utils/preview";

const siteTitle = await getSiteSetting("title");
// Intro text and the "My opinions" table are EmDash page "projects"
// (Admin → Pages); the project cards below come from the projects collection.
const { entry: projectsPage } = await getEmDashEntry("pages", "projects");

const description =
  "Description of some of the projects that Martin Driscoll is currently working on or has recently completed";
const title = "Projects";

interface TechStack {
  rendering: string;
  css: string;
  jsFramework: string;
  hosting: string;
  auth: string;
}

// Published entries, plus the draft being previewed (admin Preview).
const entries = await getEntriesWithPreview("projects", Astro.url);

const projects = entries.map((entry) => {
  const {
    title: projectTitle,
    hero_image,
    hero_alt,
    hero_video_url,
    description: projectDescription,
    tech_rendering,
    tech_css,
    tech_js_framework,
    tech_hosting,
    tech_auth,
    lessons_learned,
    notes,
  } = entry.data;

  // ProjectCard takes a plain image URL, not the full media reference.
  // EmDash's stored local media value has no reliable top-level src/url
  // field (see the equivalent blog post migration) — resolve it via the
  // same local media base path configured in astro.config.mjs.
  const storageKey = hero_image?.meta?.storageKey as string | undefined;
  const heroImage = storageKey
    ? `/_emdash/api/media/file/${storageKey}`
    : undefined;

  const techStack: TechStack = {
    rendering: tech_rendering,
    css: tech_css,
    jsFramework: tech_js_framework,
    hosting: tech_hosting,
    auth: tech_auth,
  };

  return {
    title: projectTitle,
    heroImage,
    heroAlt: hero_alt ?? "",
    heroVideoUrl: hero_video_url,
    description: projectDescription,
    techStack,
    lessonsLearned: lessons_learned,
    notes,
  };
});
---

<BaseLayout title={`${title} - ${siteTitle}`} description={description}>
  <PageAside area="aside-projects" class="aside-first" />
  <main>
    <h1>{projectsPage?.data.title ?? "Projects"}</h1>
    {
      projectsPage?.data.content && (
        <div class="prose">
          <PortableText value={projectsPage.data.content} />
        </div>
      )
    }
    <div class="project-grid full-bleed">
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>
  </main>
</BaseLayout>

<style>
  h1 {
    grid-column: measure;
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding-inline: var(--space-2);
    width: 100%;
    max-width: var(--layout-max-width);
    margin-inline: auto;
  }

  @media (min-width: 720px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
      padding-inline: var(--space-4);
    }
  }
</style>
