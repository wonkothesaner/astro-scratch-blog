---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE } from "../consts";
import { getEntry } from "astro:content";

import SortableTable from "../components/contentComponents/SortableTable.astro";
const table = await getEntry("tables", "wisdom");
if (!table) throw new Error("wisdom table not found");
const { rows, columns, caption } = table.data;

const shaped = rows.map((r: Record<string, unknown>) => {
  return {
    saying: r.note
      ? `${r.saying} <span class="note">${r.note}</span>`
      : r.saying,
    source: r.source_url
      ? `<a href="${r.source_url}" target="_blank">${r.source}</a>`
      : r.source,
  };
});
const description =
  "A living collection of sayings, phrases, thoughts and other snippets of 'wisdom' that Martin Driscoll has collected over the years";
const title = "Wisdom";
---

<BaseLayout title={`${title} - ${SITE_TITLE}`} description={description}>
  <aside class="aside-first">
    <p>
      A collection of sayings, phrases, thoughts and other snippets of 'wisdom'
      that I have been exposed to over the years.
    </p>
    <br />
    <p>
      I realize that 'wisdom' may be a little strong. I also acknowledge that I
      have largely only been exposed to words in the English language and mostly
      those written or said in the last half-century as I have never really read
      the 'classics'.
    </p>
    <br />
    <p>But one has to start somehwere.</p>
    <br />
    <p>
      Many of these inform the way I think, work and play. I will look to add to
      them over time and, if the list grows long enough, will categorize them to
      enable sorting as well.
    </p>
    <br />
    <p>
      I have tried to ensure that the attributation is correct, i.e. I have
      checked my sources as best I can. However, I continue to be amazed by the
      number of times that I confidently ascribe a saying in my head to a source
      only to find that the person never said it or were certainly not the first
      to say it.
    </p>
  </aside>
  <main>
    <h2 class="text-centered">Thoughts to work, play and live by?</h2>
    <SortableTable
      rows={shaped}
      caption={caption}
      columns={columns}
      tableClass="full-bleed page-table"
    />
  </main>
</BaseLayout>
