---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import { getEmDashCollection, getSiteSetting } from "emdash";

import SortableTable from "../components/contentComponents/SortableTable.astro";
import PageAside from "../components/pageComponents/PageAside.astro";
const siteTitle = await getSiteSetting("title");
const { entries } = await getEmDashCollection("wisdom", {
  status: "published",
});

const columns = [
  { key: "saying", label: "Saying" },
  { key: "source", label: "Source" },
];
const caption =
  "a few things I've seen or heard that help me better understand some things in life";

const shaped = entries.map((entry) => {
  const { saying, note, source, source_url } = entry.data;
  return {
    saying: note ? `${saying} <span class="note">${note}</span>` : saying,
    source: source_url
      ? `<a href="${source_url}" target="_blank">${source}</a>`
      : source,
  };
});
const description =
  "A living collection of sayings, phrases, thoughts and other snippets of 'wisdom' that Martin Driscoll has collected over the years";
const title = "Wisdom";
---

<BaseLayout title={`${title} - ${siteTitle}`} description={description}>
  <PageAside area="aside-wisdom" class="aside-first" />
  <main>
    <h2 class="text-centered">Thoughts to work, play and live by?</h2>
    <SortableTable
      rows={shaped}
      caption={caption}
      columns={columns}
      tableClass="page-table"
    />
  </main>
</BaseLayout>
