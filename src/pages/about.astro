---
export const prerender = false;

import { getEmDashEntry, getSiteSetting } from "emdash";
import { PortableText } from "emdash/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageAside from "../components/pageComponents/PageAside.astro";
import petKeyboard from "../assets/images/about/PET_Keyboard_improved.svg";

// Body text and images are EmDash-managed (Admin → Pages → "About Me"); the
// hero banner stays here — it's an SVG, which the production image service
// can't process. Left/right images are EmDash image blocks with Alignment
// set, grouped with Group breaks — see the .prose rules in global.css.
const { entry: aboutPage } = await getEmDashEntry("pages", "about");
const siteTitle = await getSiteSetting("title");
const title = aboutPage?.data.title ?? "About Me";
const description =
  "About me page for Martin Driscoll, owner and author of the site and Sane Musings.";
---

<BaseLayout title={`${title} - ${siteTitle}`} description={description}>
  <main>
    <h1 class="text-centered">{title}</h1>
    <div class="about-hero wide">
      <img
        src={petKeyboard.src}
        width={petKeyboard.width}
        height={petKeyboard.height}
        alt="Commodore PET 2001 Keyboard"
      />
    </div>
    <div class="prose">
      {aboutPage?.data.content && <PortableText value={aboutPage.data.content} />}
    </div>
  </main>
  {/* After <main> in the HTML so the story reads before the CV (screen
      readers, search engines); the grid places the columns by area, so the
      visual layout is unchanged. */}
  <PageAside area="aside-about" />
</BaseLayout>

<style>
  .about-hero img {
    display: block;
    margin-inline: auto;
    width: 100%;
    max-width: 900px;
    height: auto;
    aspect-ratio: 21 / 9;
    object-fit: contain;
  }
</style>
