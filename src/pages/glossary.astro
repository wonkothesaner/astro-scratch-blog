---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE } from "../consts";
import { getEmDashCollection } from "emdash";
import SortableTable from "../components/contentComponents/SortableTable.astro";

// Minimal Portable Text -> HTML for glossary descriptions: single-paragraph
// entries with bold spans only, the only shape these entries actually use.
// Not a general-purpose renderer. Loosely typed on purpose — the "emdash"
// package's PortableTextBlock type collides with an ambient duplicate
// declared in the project's generated emdash-env.d.ts.
function portableTextToHtml(blocks: unknown[]): string {
  return blocks
    .filter(
      (block): block is { children: { text: string; marks?: string[] }[] } =>
        typeof block === "object" && block !== null && (block as { _type?: string })._type === "block",
    )
    .map((block) =>
      block.children
        .map((span) =>
          span.marks?.includes("strong") ? `<strong>${span.text}</strong>` : span.text,
        )
        .join(""),
    )
    .join(" ");
}

const { entries } = await getEmDashCollection("glossary", { status: "published" });

const columns = [
  { key: "tla", label: "Acronym" },
  { key: "description", label: "Description" },
];
const caption = "Some three and four letter acroynms that you may want to understand better";

const rows = entries.map((entry) => {
  const { term, description } = entry.data;
  return { tla: term, description: portableTextToHtml(description) };
});

const description =
  "Glossary of terms that may help navigate the writings on the site as well as real life.";
const title = "Glossary";
---

<BaseLayout title={`${title} - ${SITE_TITLE}`} description={description}>
  <aside class="aside-first">
    <p>An attempt at humour.</p>
    <br />
    <p>
      Glossary of some Terms that may (or may not) help you navigate the musings
      on this site and/or life in general.
    </p>
    <br />
    <p>
      Clearly I accept no responsibility for any accidents that may happen as a
      result of taking any of this seriously
    </p>
  </aside>
  <main>
    <h2 class="text-centered wide">
      Some three (or more) letter acronyms (TLAs)
    </h2>
    <SortableTable
      rows={rows}
      columns={columns}
      caption={caption}
      tableClass="full-bleed page-table"
    />
  </main>
</BaseLayout>
