---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <aside class="aside-first">
    <p>An attempt at humour.</p>
    <br />
    <p>
      Glossary of some Terms that may (or may not) help you navigate the musings
      on this site and/or life in general.
    </p>
    <br />
    <p>
      Clearly I accept no responsibility for any accidents that may happen as a
      result of taking any of this seriously
    </p>
  </aside>
  <main>
    <h2 class="text-centered wide">
      Some three (or more) letter acronyms (TLAs)
    </h2>
    <table class="full-bleed page-table">
      <tr>
        <th class="text-centered">TLA</th>
        <th>Description</th>
      </tr>
      <tr>
        <td>HWGA</td>
        <td
          ><strong>Here we go again</strong>. A feeling currently most often
          felt around the dinner table.</td
        >
      </tr>
      <tr>
        <td>TL;DR</td>
        <td
          ><strong>Too long; didn't read</strong>. What people say when they
          think you have a short attention span but want you to read on anyway.</td
        >
      </tr>
      <tr>
        <td>BTW</td>
        <td><strong>By the way</strong>. Or the VAT Tax you pay in Belgium.</td>
      </tr>
      <tr>
        <td>TOB</td>
        <td
          ><strong>Taks op beursverrichtingen</strong> (tax on stock exchnage transactions).
          Another tax, this one a transaction tax placed by the Belgian authorities
          on any buy or sell stock market transaction one makes. Just don't ask anyone
          to explain how it works or which TOB tax rate to apply to which transaction.</td
        >
      </tr>
    </table>
  </main>
</BaseLayout>
