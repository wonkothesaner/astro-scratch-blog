---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteSetting } from "emdash";
import { getEntriesWithPreview } from "../utils/preview";
import SortableTable from "../components/contentComponents/SortableTable.astro";
import PageAside from "../components/pageComponents/PageAside.astro";

const siteTitle = await getSiteSetting("title");

// Minimal Portable Text -> HTML for glossary descriptions: single-paragraph
// entries with bold spans only, the only shape these entries actually use.
// Not a general-purpose renderer. Loosely typed on purpose — the "emdash"
// package's PortableTextBlock type collides with an ambient duplicate
// declared in the project's generated emdash-env.d.ts.
function portableTextToHtml(blocks: unknown[]): string {
  return blocks
    .filter(
      (block): block is { children: { text: string; marks?: string[] }[] } =>
        typeof block === "object" &&
        block !== null &&
        (block as { _type?: string })._type === "block",
    )
    .map((block) =>
      block.children
        .map((span) =>
          span.marks?.includes("strong")
            ? `<strong>${span.text}</strong>`
            : span.text,
        )
        .join(""),
    )
    .join(" ");
}

// Published entries, plus the draft being previewed (admin Preview).
const entries = await getEntriesWithPreview("glossary", Astro.url);

const columns = [
  { key: "tla", label: "Acronym" },
  { key: "description", label: "Description" },
];
const caption =
  "Some three and four letter acronyms that you may want to understand better";

const rows = entries.map((entry) => {
  const { term, description } = entry.data;
  return { tla: term, description: portableTextToHtml(description) };
});

const description =
  "Glossary of terms that may help navigate the writings on the site as well as real life.";
const title = "Glossary";
const captionTitle = "Table of Glossary entries";
---

<BaseLayout title={`${title} - ${siteTitle}`} description={description}>
  <PageAside area="aside-glossary" class="aside-first" />
  <main>
    <h2 class="text-centered wide">
      Some three (or more) letter acronyms (TLAs)
    </h2>
    <SortableTable
      rows={rows}
      columns={columns}
      caption={caption}
      tableClass="page-table"
      captionTitle={captionTitle}
    />
  </main>
</BaseLayout>
