---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCard from "../components/contentComponents/BlogCard.astro";
import PageAside from "../components/pageComponents/PageAside.astro";
import ImpactBlock from "../components/contentComponents/ImpactBlock.astro";
import { getEmDashEntry, getSiteSetting } from "emdash";
import { PortableText } from "emdash/ui";
import { getHomePostLists } from "../utils/blog";

const { pinned, recent } = await getHomePostLists();

const { entry: homePage } = await getEmDashEntry("pages", "home");
const siteTitle = await getSiteSetting("title");
const siteDescription = await getSiteSetting("tagline");
---

<BaseLayout title={siteTitle ?? ""} description={siteDescription ?? ""}>
  {/* Fallback is the live recent-posts list; creating widget area
      aside-home in EmDash would replace it */}
  <PageAside area="aside-home">
    {pinned.length > 0 && <h2>Pinned posts</h2>}
    {pinned.map((post) => <BlogCard post={post} />)}
    <h2>Recent posts</h2>
    {recent.map((post) => <BlogCard post={post} />)}
  </PageAside>
  <main>
    {
      homePage?.data.content && (
        <PortableText
          value={homePage.data.content}
          components={{ block: { blockquote: ImpactBlock } }}
        />
      )
    }
  </main>
</BaseLayout>
