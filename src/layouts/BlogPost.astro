---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/utilityComponents/FormattedDate.astro";

type Props = CollectionEntry<"blog">["data"] & {
  pageType?: "website" | "article";
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroImageAlt,
  heroFit,
  heroAspectRatio,
  heroPortrait,
  pageType = "article",
} = Astro.props;

const { pathname } = Astro.url;
---

<BaseLayout
  title={title}
  description={description}
  pageType={pageType}
  pubDate={pubDate}
  updatedDate={updatedDate}
  author="Martin Driscoll"
>
  <main>
    <div
      class="hero-image wide"
      data-fit={heroFit}
      data-portrait={heroPortrait}
      style={heroAspectRatio ? `--hero-aspect: ${heroAspectRatio}` : undefined}
      id={pathname === "/about" ? "about-hero-image" : undefined}
    >
      {heroImage && <Image src={heroImage} alt={heroImageAlt ?? ""} priority />}
    </div>
    <article>
      <div class="prose">
        <div class="title">
          <h1>{title}</h1>
          <div class="date">
            Published: <FormattedDate date={pubDate} />
            {
              updatedDate && (
                <div class="last-updated-on">
                  Last updated: <FormattedDate date={updatedDate} />
                </div>
              )
            }
          </div>
          <hr />
        </div>
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .hero-image {
    width: 100%;
  }
  .hero-image img {
    display: block;
    margin: 0 auto;
    border-radius: 0;
    box-shadow: var(--box-shadow);
    width: 100%;
    max-width: 900px;
    height: auto;
    aspect-ratio: var(--hero-aspect, 21 / 9);
    object-fit: cover;
  }

  .hero-image[data-fit="contain"] img {
    object-fit: contain;
    box-shadow: none;
  }

  .hero-image[data-portrait="true"] img {
    max-width: min(500px, 100%);
  }

  .title {
    margin-bottom: 1em;
    padding: 1em 0;
    text-align: center;
    line-height: 1;
  }
  .title h1 {
    margin: 0 0 0.5em 0;
  }
  .date {
    margin-bottom: 0.5em;
    color: var(--color-meta);
  }
  .last-updated-on {
    font-style: italic;
    margin-top: 0.5em;
    font-size: 0.8em;
    color: var(--color-meta);
  }
</style>
