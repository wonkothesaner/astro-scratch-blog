---
import { Image } from "astro:assets";
import { Image as EmdashImage } from "emdash/ui";
import FormattedDate from "../utilityComponents/FormattedDate.astro";
import type { PostCard } from "../../utils/blog";
import { CATEGORIES } from "../../consts";

interface Props {
  post: PostCard;
}

const { post } = Astro.props;
---

<article class="blog-card">
  <a href={post.url}>
    {post.heroImage?.kind === "emdash" && (
      <EmdashImage
        image={post.heroImage.value}
        alt=""
        width={800}
        height={600}
        sizes="(min-width: 600px) 33vw, 100vw"
        loading="lazy"
      />
    )}
    {post.heroImage?.kind === "file" && (
      <Image
        src={post.heroImage.asset}
        alt=""
        widths={[200, 400, 600, 800]}
        sizes="(min-width: 600px) 33vw, 100vw"
        loading="lazy"
      />
    )}
    <div class="blog-card__body">
      <h3>{post.title}</h3>
      <FormattedDate date={post.pubDate} />
      {post.category && <p>A Sane Musing on <strong>{CATEGORIES[post.category]}</strong></p>}
      {post.description && <p>{post.description}</p>}
    </div>
  </a>
</article>

<style>
  .blog-card {
    container-type: inline-size;
  }

  .blog-card a {
    margin: 1em;
    display: grid;
    gap: var(--space-2);
    text-decoration: none;
    color: inherit;
  }

  .blog-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .blog-card h3 {
    margin: 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-heading);
  }

  .blog-card p {
    margin: 0;
    font-size: var(--font-size-sm);
  }

  .blog-card a:hover h3 {
    color: var(--color-link-hover);
  }

  @container (min-width: 420px) {
    .blog-card a {
      grid-template-columns: 1fr 2fr;
      align-items: start;
      gap: var(--space-3);
    }

    .blog-card img {
      aspect-ratio: 4 / 3;
    }

    .blog-card h3 {
      font-size: var(--font-size-base);
    }
  }
</style>
