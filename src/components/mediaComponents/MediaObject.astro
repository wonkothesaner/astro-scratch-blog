---
// filepath: /Users/martindriscoll/Documents/web_projects/astro_scratch/astro-scratch-blog/src/components/layoutComponents/MediaObject.astro
import { Image } from "astro:assets";

interface Props {
  image: ImageMetadata;
  alt: string; // Alt text for the image
  source?: string; // Optional source text for the image
  flip?: boolean;
  imageWidth?: string; // e.g. "200px", "300px", "400px"
}

const { image, alt, source, flip, imageWidth } = Astro.props as Props;

const mediaClass = flip ? "media media-flip" : "media";
---

<div
  class={mediaClass}
  style={imageWidth ? `--media-image-width: ${imageWidth}` : undefined}
>
  <div class="img">
    <Image src={image} alt={alt} />
    <p class="source">
      {source && <span>Source: {source}</span>}
    </p>
  </div>
  <div class="media-content">
    <slot />
    {/* Content will be inserted here */}
  </div>
</div>

<style>
  .media {
    display: grid;
    grid-template-areas:
      "image"
      "content";
    gap: var(--space-3);
    margin-block-end: var(--space-3);
    align-items: start;
  }

  .img {
    grid-area: image;
  }
  .media-content {
    grid-area: content;
  }

  .media img {
    width: 100%;
    height: auto;
    max-width: var(--media-image-width, 200px);
    margin-inline: auto;
    display: block;
  }

  .source {
    margin-block-start: var(--space-1);
    font-size: var(--font-size-sm);
    color: var(--color-gray-light);
  }

  @media (min-width: 640px) {
    .media {
      grid-template-columns: fit-content(var(--media-image-width, 200px)) 1fr;
      grid-template-areas: "image content";
    }

    .media-flip {
      grid-template-columns: 1fr fit-content(var(--media-image-width, 200px));
      grid-template-areas: "content image";
    }

    .media img {
      max-width: none; /* let the grid column control width above 640px */
      margin-inline: 0;
    }
  }
</style>
