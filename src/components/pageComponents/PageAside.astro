---
// Page sidebar whose content is editable in EmDash (Admin → Widgets).
// Renders the named widget area when it has widgets; otherwise falls back to
// the slot content, so a page never goes blank while its area is still
// empty. With neither, no <aside> is rendered at all and the page lays out
// full-width. Area names follow the `aside-<page>` convention.
import { getWidgetArea } from "emdash";
import { WidgetArea } from "emdash/ui";

interface Props {
  area: string;
  class?: string;
}

const { area, class: className } = Astro.props;
// Request-cached, so WidgetArea's own lookup below costs no extra query.
const widgetArea = await getWidgetArea(area);
const hasWidgets = (widgetArea?.widgets.length ?? 0) > 0;
const fallback =
  !hasWidgets && Astro.slots.has("default")
    ? ((await Astro.slots.render("default")) ?? "").trim()
    : "";
---

{
  (hasWidgets || fallback) && (
    <aside class={className}>
      {/* One wrapper whatever the source, so the aside's look lives in
          one place (.aside-panel in global.css) and can't drift */}
      <div class="aside-panel">
        {hasWidgets ? (
          <WidgetArea name={area} />
        ) : (
          <Fragment set:html={fallback} />
        )}
      </div>
    </aside>
  )
}
