---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../../styles/global.css";
import { createPublicPageContext } from "emdash/page";
import { EmDashHead } from "emdash/ui";
import { getSiteSetting } from "emdash";

const siteTitle = await getSiteSetting("title");

interface Props {
  title: string;
  description: string;
  image?: string;
  pageType?: "website" | "article";
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
}

const {
  title,
  description,
  image = "/ogimage.png",
  pageType = "website",
  pubDate,
  updatedDate,
  author,
} = Astro.props;

// OG/Twitter/canonical/JSON-LD are generated by <EmDashHead> below, from
// site settings (title, tagline, SEO plugin identity) plus this per-page
// context — not hand-rolled here. `content`/i18n hreflang doesn't apply
// to this site, so it's intentionally omitted.
const page = createPublicPageContext({
  Astro,
  kind: pageType === "article" ? "content" : "custom",
  pageType,
  title,
  description,
  // Absolutized — social-card scrapers (Slack, LinkedIn) often refuse to
  // follow relative image URLs, and the per-page `image` prop isn't run
  // through EmDashHead's own absolutizing (that only applies to the site's
  // configured default OG image fallback).
  image: new URL(image, Astro.site).toString(),
  // Not auto-derived from Astro.url — canonical/og:url are both omitted
  // entirely by generateBaseSeoContributions() if this isn't set explicitly.
  canonical: new URL(Astro.url.pathname, Astro.site).toString(),
  articleMeta:
    pageType === "article"
      ? {
          publishedTime: pubDate?.toISOString(),
          modifiedTime: (updatedDate ?? pubDate)?.toISOString(),
          author: author ?? "Martin Driscoll",
        }
      : undefined,
});
---

{/* Security & Privacy meta tags */}
{
  import.meta.env.PROD && (
    <>
      <meta
        http-equiv="Content-Security-Policy"
        content="default-src 'self'; script-src 'self' static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' static.cloudflareinsights.com cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'"
      />
      <meta name="referrer" content="strict-origin-when-cross-origin" />
    </>
  )
}
{/* End security & privacy meta tags */}

{/* Global Metadata */}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.ico" type="image/x-icon" />
<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={siteTitle}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

{/* Font preloads */}
<link
  rel="preload"
  href="/fonts/atkinson-regular.woff"
  as="font"
  type="font/woff"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/atkinson-bold.woff"
  as="font"
  type="font/woff"
  crossorigin
/>

{/* Primary title — <title> itself isn't an EmDashHead contribution kind */}
<title>{title}</title>

{/* Canonical URL, OG, Twitter Card, JSON-LD, and Google/Bing verification
    (from site settings) are all generated here — see the SEO plugin
    (@jdevalk/emdash-plugin-seo) and page context built above. */}
<EmDashHead page={page} />

{/* Cloudflare Web Analytics */}
{
  import.meta.env.PROD && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "3dff1f363e0a4b848a18dc361245f880"}'
    />
  )
}
{/* End Cloudflare Web Analytics */}
