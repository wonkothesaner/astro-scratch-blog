# @jdevalk/emdash-plugin-seo declares peerDependencies emdash@^0.21.0; the
# project is on emdash@0.35.0. Verified (astro check + npm run build) that
# the plugin works correctly against 0.35.0 in practice — the peer range is
# just stale, not a real incompatibility. Without this, npm install fails
# with ERESOLVE (including in Workers Builds' own install step).
legacy-peer-deps=true
